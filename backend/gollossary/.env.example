# Gollossary environment variables
# Скопируйте в .env и заполните значения

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=Lms-proj
COLLECTION_NAME=gollossary

# LLM Backend: "local" (GGUF через llama-cpp-python) или "gemini" (Google Gemini API)
LLM_BACKEND=local

# Local GGUF model (используется при LLM_BACKEND=local)
LLM_MODEL_PATH=
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=0        # 0=CPU, -1=все слои на GPU
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Google Gemini API (используется при LLM_BACKEND=gemini)
# Получите ключ на: https://aistudio.google.com/app/apikey
# Доступные модели: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_API_KEY=AIzaSyCh9ZZZLqw2bOkqpdka3PF3RPdKAaLCPog
GEMINI_MODEL=gemini-2.5-flash

# Обработка лекций
MAX_CHUNK_CHARS=3000      # Символов в одном чанке
CHUNK_OVERLAP_CHARS=200   # Перекрытие между чанками
MAX_CONCEPTS=50           # Макс. понятий на лекцию
LANGUAGE=ru               # ru или en

# Порты
LECTURE_PROCESSOR_PORT=8001
CONCEPT_CRUD_PORT=8002
