# Frontend Environment Variables
VITE_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3002

# API URL: пустое значение → только через Vite proxy (/api → BACKEND_TARGET)
# Для корректной загрузки статики (/profile-media, /course-media) укажем явный адрес backend:
VITE_API_URL=http://localhost:3002

# Socket.IO: empty = connects to the same host as the page (via Vite proxy)
VITE_SOCKET_URL=

# Vite proxy target for /api requests
BACKEND_TARGET=http://localhost:3002

