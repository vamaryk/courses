# Frontend Environment Variables
VITE_APP_ENV=development

# ==========================================
# LOCAL / TUNNEL SWITCH
# ==========================================
# Tunnel mode:
# - open site through xtunnel on Vite port 5173
# - frontend uses same-origin requests
# - Vite proxies /api, /socket.io and media to BACKEND_TARGET
NEXT_PUBLIC_API_URL=
VITE_API_URL=
VITE_SOCKET_URL=
BACKEND_TARGET=http://localhost:3002

# Quick rollback to old direct-backend mode:
# Uncomment lines below and comment the 4 lines above.
# NEXT_PUBLIC_API_URL=http://localhost:3002
# VITE_API_URL=http://localhost:3002
# VITE_SOCKET_URL=
# BACKEND_TARGET=http://localhost:3002

# Gollossary Python microservices
VITE_GOLLOSSARY_API_URL=http://127.0.0.1:8002
VITE_GOLLOSSARY_PROCESSOR_URL=http://127.0.0.1:8001

NODE_ENV=development
JWT_SECRET=bed5dbad14121bf320c6221e9287313b
PORT=3002
